# ESP32-WROOM-32 modules carry 4MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Console over UART0, which the on-board USB-UART bridge (CP2102/CH340) exposes
# on the micro-USB port. The classic ESP32 has no USB Serial/JTAG peripheral.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
