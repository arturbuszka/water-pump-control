	(paper "A4")
	(title_block
		(title "waterpumpmod - ESP32 interval water pump controller")
		(date "2026-09-19")
		(rev "A")
		(comment 1 "ESP32-WROOM-32 DevKit + 1CH opto-isolated relay module, 5V pump")
		(comment 2 "Relay IN on GPIO27 - RTC-capable, latched through deep sleep, active LOW")
		(comment 3 "Cut ONLY the pump positive wire. Ground stays continuous and shared.")
		(comment 4 "C1/C2 sit across the 5V rail to ride out the pump inrush (brownout)")
	)
